# URL base da API (.NET). Em dev local, use a porta "http" do launchSettings.json do SAVi.Api.
VITE_API_URL=http://localhost:5285

# Client ID OAuth criado no Google Cloud Console (não é secreto, mas mantenha por variável de ambiente
# para trocar facilmente entre dev/produção sem tocar no código).
VITE_GOOGLE_CLIENT_ID=
